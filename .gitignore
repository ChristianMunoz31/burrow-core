# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

node_modules
dist
!public/interface-library/dist/
dist-ssr
coverage/
test-results/
playwright-report/
blob-report/
*.local

# Environment — never commit secrets
.env
.env.*
!.env.example

# Local data — never commit personal data
/data/
*.db
*.db-wal
*.db-shm
*.bak
secrets.key
*.tsv
*.xlsx
*.csv
!e2e/fixtures/*.csv

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local settings
.claude/settings.local.json
.claude/worktrees/

# Local-only list of private terms (real names, addresses) the personal-data check must reject
.personal-denylist

# Desktop sidecar build output
/.sidecar-build/
/src-tauri/binaries/
/src-tauri/resources/
/src-tauri/target/
/src-tauri/gen/
/src-tauri/tauri.dev.build.json
/.dev-build/

# Licensing: the activation record holds the buyer's email, private keys never belong in the repo
*.burrowlicense
*.private.pem
# Updater signing keys live outside every repo (docs/RELEASING.md); a stray key file and the tauri key folder stay out
*.key
.tauri/
license-clock.json
license-trial.json
license-activation.json

# Stray file created when bash redirects to Windows "nul"; use /dev/null in bash
nul

# Burrow Pro: a separate private nested repo, never part of the core (docs/adr/0001-open-core-split.md)
/pro/
