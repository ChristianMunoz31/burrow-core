# Burrow configuration. Copy to .env and fill in what you need. Every value is optional.
# Nothing here is required to run Burrow; nothing leaves your machine unless you opt in.

# --- Server ---
# Interface to listen on. Default is loopback only.
BURROW_HOST=
# Port to listen on. Default 4321.
BURROW_PORT=
# Where Burrow keeps its data. Default is a per-user folder (see README).
BURROW_DATA_DIR=
# Set to 1 only when running behind exactly one reverse proxy.
BURROW_TRUST_PROXY=
# Set to 0 to turn off the built-in daily scheduler (briefing + audit-log prune).
BURROW_SCHEDULER=
# Comma-separated browser origins allowed to call the API cross-origin.
# Default is localhost / 127.0.0.1 on the Burrow port and the Vite dev port.
ALLOWED_ORIGINS=
# Comma-separated host[:port] names the server accepts in the Host header (DNS-rebinding
# guard). Loopback names and the Vite dev port are always accepted; add the name you use
# from a LAN device or reverse proxy, e.g. burrow.lan,nas.local:4321.
BURROW_ALLOWED_HOSTS=
# Set to 1 to allow listening on a non-loopback BURROW_HOST WITHOUT sign-in (not
# recommended; a loud warning is logged). Otherwise such a bind needs APP_PASSWORD + AUTH_SECRET.
BURROW_ALLOW_INSECURE_LAN=

# --- Network opt-in (all OFF by default) ---
# Comma-separated features to pre-enable: weather, oura, sheets, cloudAi, aiLan.
# You can also toggle these in Settings > Network.
BURROW_NETWORK_OPTIN=

# --- Sign-in (optional) ---
# Set both to require a password. AUTH_SECRET must be at least 32 characters (the server
# refuses to start otherwise). Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_PASSWORD=
AUTH_SECRET=

# --- Saved API keys ---
# Optional. 32-byte base64 key used to encrypt API keys saved in Settings. When unset,
# Burrow creates a random key once as secrets.key in the data folder (kept out of exports)
# so saving keys works out of the box. Back that file up with your data; set this variable to override it.
SECRETS_ENCRYPTION_KEY=

# --- Local AI (Ollama) ---
# Javi runs on a local Ollama server. Install Ollama, then e.g. `ollama pull qwen2.5:7b`.
# Set to 0 to turn off every AI feature.
# BURROW_AI=1
# Ollama address (no scheme means http://, port 11434; 0.0.0.0 means this machine).
# A host on another machine also needs the "aiLan" Network opt-in.
# OLLAMA_HOST=http://127.0.0.1:11434
# Context window sent to Ollama (capped at the model's own limit).
# OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model loaded after a request.
# OLLAMA_KEEP_ALIVE=10m
# Model overrides (a choice saved in Settings > AI wins). Default: picked automatically.
BURROW_AI_CHAT_MODEL=
BURROW_AI_TOOL_MODEL=
# Largest model (billions of parameters) the automatic choice may pick.
# BURROW_AI_AUTO_MAX_PARAMS_B=14
# Timeouts and queue for model calls.
# First-token wait covers loading the model; a cold first prompt on a CPU-only machine can
# take a couple of minutes.
# BURROW_AI_FIRST_TOKEN_TIMEOUT_MS=300000
# BURROW_AI_TOTAL_TIMEOUT_MIN=5
# BURROW_AI_CONCURRENCY=1
# BURROW_AI_QUEUE_MAX=8
# BURROW_AI_QUEUE_TIMEOUT_MS=300000
# BURROW_AI_HEALTH_TTL_MS=5000
# Javi tool loop.
# Per tool round; keep it at least as long as the first-token timeout.
# JARVIS_ROUND_TIMEOUT_MS=300000
# JARVIS_MAX_ROUNDS=5
# JARVIS_WRITE_CAP=3
# JARVIS_TOOL_TIMEOUT_MS=12000
# Set to 0 to let Javi make changes without asking first.
# JARVIS_CONFIRM_WRITES=1
# Optional OpenAI-compatible cloud provider (off unless chosen in Settings > AI and the
# cloudAi Network opt-in is on). Prefer saving the key in Settings.
AI_CLOUD_API_KEY=

# --- Optional integrations (each also needs its Network opt-in) ---
OURA_TOKEN=
# Fallback weather location, used only when the browser does not share its location.
WEATHER_LAT=
WEATHER_LON=
