{
  "name": "burrow",
  "private": true,
  "version": "2.0.0",
  "description": "Burrow - a local-first personal data OS.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "node server.js",
    "build": "vite build",
    "postbuild": "node scripts/license/writeBuildInfo.js",
    "build:devtools": "vite build --mode devtools",
    "postbuild:devtools": "node scripts/license/writeBuildInfo.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:parser": "vitest run --config vitest.parser.config.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "node scripts/visualUpdate.js",
    "setup:labels": "node scripts/setupLabels.js",
    "import": "node scripts/import.js",
    "eval:javi": "node scripts/evalJavi.js",
    "prepare": "node scripts/installHooks.js",
    "check": "npm run check:em-dash && npm run check:personal && npm run check:keys && npm run check:privacy",
    "check:em-dash": "node scripts/checks/noEmDash.js",
    "check:personal": "node scripts/checks/personalData.js",
    "check:keys": "node scripts/checks/noPrivateKeys.js",
    "check:privacy": "node scripts/privacy/checkPrivacy.mjs",
    "privacy:render": "node scripts/privacy/renderPrivacy.mjs",
    "check:bundle": "node scripts/checks/bundleBudget.js",
    "check:pro-present": "node scripts/checks/proPresent.js",
    "check:licenses": "node scripts/checks/licenseAudit.js",
    "seed:demo": "node scripts/seedDemo.js",
    "sandbox": "node scripts/sandbox.js",
    "sandbox:reset": "node scripts/sandbox.js --reset",
    "preview:branch": "node scripts/previewBranch.js",
    "preview:clean": "node scripts/previewBranch.js --clean",
    "fake:ollama": "node scripts/fakeOllama.js",
    "desktop:sidecar": "node scripts/desktop/buildSidecar.js --minify",
    "desktop:dev": "node scripts/desktop/dev.js",
    "desktop:build": "node scripts/desktop/build.js",
    "desktop:build:dev": "node scripts/desktop/buildDev.js",
    "desktop:install": "node scripts/desktop/installLocal.mjs",
    "dev:update": "git pull --ff-only && npm run desktop:install -- --yes --close",
    "desktop:icons": "node scripts/desktop/icons.js",
    "desktop:installer-images": "node scripts/desktop/installerImages.js",
    "release:installer": "node scripts/release/buildInstaller.js",
    "release:local": "node scripts/release/releaseLocal.mjs",
    "release:auto": "node scripts/release/releaseAuto.mjs",
    "release:gumroad": "node scripts/release/syncGumroad.mjs",
    "release:store": "node scripts/release/buildStore.mjs",
    "export:core": "node scripts/release/exportCore.mjs",
    "store:screenshots": "node scripts/store/screenshots.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.50.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "node-fetch": "^3.3.1",
    "node-ical": "^0.27.2",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "acorn": "^8.19.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "form-data": {
      "mime-types": "^3.0.2"
    }
  }
}
